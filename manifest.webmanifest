{
  "name": "Listening Pro",
  "short_name": "Listening Pro",
  "description": "Listening Pro - static PWA for listening practice, designed for GitHub Pages and mobile Safari.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eaf1ff",
  "theme_color": "#dfe9ff",
  "orientation": "portrait",
  "icons": [
    {
      "src": "assets/favicon/icon-standard.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "assets/favicon/icon-iphone.svg",
      "sizes": "180x180",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "assets/favicon/icon-ipad.svg",
      "sizes": "167x167",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
